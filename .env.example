# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL database name
DB_NAME=northwind

# PostgreSQL username
DB_USER=postgres

# PostgreSQL password (CHANGE IN PRODUCTION!)
DB_PASSWORD=postgres

# Database host (use 'db' for Docker, 'localhost' for local)
DB_HOST=db

# Database port
DB_PORT=5432

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# Secret key for JWT token signing (MUST be at least 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# JWT token expiration in seconds (86400 = 24 hours)
JWT_EXPIRATION=86400

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Allowed CORS origins (comma-separated for production)
# Example: https://app.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
# API URL for frontend (used during build)
VITE_API_URL=http://localhost:8000/api/v1

# Frontend port for production
FRONTEND_PORT=80
